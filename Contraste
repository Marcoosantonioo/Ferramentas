<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Validador de Contraste de Cores - WCAG</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
:root {
  --bg-page:    #F3F5F7;
  --bg-card:    #FFFFFF;
  --bg-input:   #FFFFFF;
  --border:     #000000;
  --text:       #000000;
  --accent:     #0131FF;
  --pass:       #0131FF;
  --fail:       #C44000;
  --shadow:     0 4px 6px -1px rgba(0,0,0,0.25);
}
:root[data-theme="dark"] {
  --bg-page:  #000000;
  --bg-card:  #121212;
  --bg-input: #1A1A1A;
  --border:   #FFFFFF;
  --text:     #FFFFFF;
  --accent:   #6B8FFF;
  --pass:     #6B8FFF;
  --fail:     #FF8C42;
  --shadow:   0 4px 6px -1px rgba(255,255,255,0.15);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: system-ui, -apple-system, sans-serif;
  background: var(--bg-page);
  color: var(--text);
  display: flex;
  justify-content: center;
  align-items: flex-start;
  min-height: 100vh;
  padding: 40px 20px;
}
:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 3px;
  border-radius: 2px;
}
.picker-hex-input:focus-visible {
  outline: none;
  outline-offset: 0;
  border-color: var(--accent);
  box-shadow: 0 0 0 2px var(--accent);
}
.sr-only {
  position: absolute; width: 1px; height: 1px;
  padding: 0; margin: -1px; overflow: hidden;
  clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}

/* ── LAYOUT ── */
.container { width: 100%; max-width: 900px; display: flex; flex-direction: column; gap: 24px; }
.header-bar { display: flex; justify-content: flex-end; }
.theme-select {
  background: var(--bg-card); color: var(--text);
  border: 2px solid var(--border); padding: 8px 16px;
  border-radius: 20px; font-size: 0.9rem; font-weight: 500; cursor: pointer;
}
.theme-select:hover { border-color: var(--accent); }

/* ── PREVIEW ── */
.preview-area {
  min-height: 250px; display: flex; flex-direction: column;
  justify-content: center; align-items: center; text-align: center;
  padding: 40px; border-radius: 12px; border: 2px solid var(--border);
}
.preview-area h2 { font-size: 3rem; font-weight: 700; margin-bottom: 16px; }
.preview-area p  { font-size: 1.25rem; }

/* ── CARDS DE ENTRADA ── */
.controls { display: flex; gap: 20px; flex-wrap: wrap; }
.input-card {
  flex: 1; min-width: 280px; background: var(--bg-card);
  border: 2px solid var(--border); border-radius: 12px;
  padding: 16px; display: flex; flex-direction: column; gap: 12px;
}
.input-label {
  font-size: 0.875rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.5px;
}
.input-row { display: flex; gap: 12px; align-items: center; position: relative; }

/* Input HEX principal */
.hex-main-input {
  flex: 1; height: 48px;
  background: var(--bg-input); color: var(--text);
  border: 2px solid var(--border); border-radius: 8px;
  padding: 0 16px; font-size: 1rem; font-family: monospace;
  font-weight: bold; text-transform: uppercase;
  transition: border-color 0.2s;
}
.hex-main-input:focus { border-color: var(--accent); }

/* ── COLOR PICKER CUSTOMIZADO ── */
.color-swatch-btn {
  width: 48px; height: 48px; border-radius: 8px;
  border: 2px solid var(--border); cursor: pointer;
  padding: 0; flex-shrink: 0; background: #000;
}
.color-swatch-btn:hover { border-color: var(--accent); }

.picker-popover {
  display: none; position: absolute;
  z-index: 1000; top: calc(100% + 8px); left: 0;
  background: var(--bg-card); border: 2px solid var(--border);
  border-radius: 12px; padding: 16px; width: 220px;
  box-shadow: var(--shadow); flex-direction: column; gap: 12px;
}
.picker-popover.open { display: flex; }

.picker-canvas-wrap {
  position: relative; width: 100%; height: 140px;
  border-radius: 8px; overflow: hidden;
  border: 1px solid var(--border); cursor: crosshair;
}
.picker-canvas { display: block; width: 100%; height: 100%; }
.picker-cursor {
  position: absolute; width: 14px; height: 14px; border-radius: 50%;
  border: 2px solid #FFF; box-shadow: 0 0 0 1px #000;
  pointer-events: none; transform: translate(-50%, -50%);
  top: 0; left: 100%;
}

.picker-hue-wrap {
  position: relative; height: 16px; border-radius: 8px;
  overflow: hidden; border: 1px solid var(--border); cursor: pointer;
  background: linear-gradient(to right, #F00, #FF0, #0F0, #0FF, #00F, #F0F, #F00);
}
.picker-hue-thumb {
  position: absolute; top: 50%; transform: translate(-50%, -50%);
  width: 16px; height: 16px; border-radius: 50%;
  border: 2px solid #FFF; box-shadow: 0 0 0 1px #000;
  pointer-events: none; left: 0;
}

.picker-hex-row { display: flex; align-items: center; gap: 8px; }
.picker-hex-label {
  font-size: 0.75rem; font-weight: 700;
  text-transform: uppercase; white-space: nowrap;
}
.picker-hex-input {
  flex: 1; height: 32px;
  background: var(--bg-input); color: var(--text);
  border: 2px solid var(--border); border-radius: 6px;
  padding: 0 8px; font-size: 0.85rem; font-family: monospace;
  font-weight: bold; text-transform: uppercase; outline: none;
}


.picker-actions { display: flex; gap: 8px; align-items: center; justify-content: space-between; }

.picker-eyedropper-btn {
  display: flex; align-items: center; gap: 6px;
  background: var(--bg-input); color: var(--text);
  border: 2px solid var(--border); border-radius: 6px;
  padding: 6px 10px; font-size: 0.85rem; font-weight: 700;
  cursor: pointer;
}
.picker-eyedropper-btn:hover { background: var(--accent); color: #FFF; border-color: var(--accent); }
.picker-eyedropper-btn svg { width: 16px; height: 16px; fill: currentColor; flex-shrink: 0; }
/* Oculta o botão em navegadores sem suporte à EyeDropper API */
.picker-eyedropper-btn.unsupported { display: none; }

.picker-close-btn {
  background: var(--bg-input); color: var(--text);
  border: 2px solid var(--border); border-radius: 6px;
  padding: 6px 12px; font-size: 0.85rem; font-weight: 700;
  cursor: pointer;
}
.picker-close-btn:hover { background: var(--accent); color: #FFF; border-color: var(--accent); }

/* ── RAZÃO DE CONTRASTE ── */
.ratio-header {
  text-align: center; background: var(--bg-card);
  padding: 20px; border-radius: 12px; border: 2px solid var(--border);
}
.ratio-label { font-size: 0.9rem; font-weight: 700; text-transform: uppercase; }
.ratio-value { font-size: 3rem; font-weight: 800; letter-spacing: -1px; }

/* ── CARDS DE RESULTADO ── */
.results-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 16px;
}
.result-card {
  background: var(--bg-card); border: 2px solid var(--border);
  border-radius: 8px; padding: 16px;
  display: flex; flex-direction: column; gap: 8px;
}
.result-card.pass { border-color: var(--pass); }
.result-card.fail { border-color: var(--fail); }
.card-header {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 0.95rem; font-weight: 600;
}
.wcag-version { font-size: 0.75rem; }
.status { font-size: 1.1rem; font-weight: 700; display: flex; align-items: center; gap: 6px; }
.status.pass { color: var(--pass); }
.status.fail { color: var(--fail); }
.req-text { font-size: 0.85rem; font-weight: bold; }

/* ── BOTÕES DE AÇÃO ── */
.actions { display: flex; gap: 16px; }
.btn {
  flex: 1; background: var(--bg-card); color: var(--text);
  border: 2px solid var(--border); padding: 14px; border-radius: 8px;
  cursor: pointer; font-size: 1rem; font-weight: 700;
  display: flex; align-items: center; justify-content: center; gap: 10px;
}
.btn:hover { background: var(--accent); border-color: var(--accent); color: #FFF; }
.btn:hover svg { fill: #FFF; }
.btn svg { width: 20px; height: 20px; fill: currentColor; }

/* ── FAQ ── */
.faq-section { margin-top: 32px; display: flex; flex-direction: column; gap: 16px; }
.faq-section > h2 { font-size: 1.3rem; font-weight: 700; }
.faq-item {
  background: var(--bg-card); border: 2px solid var(--border);
  border-radius: 8px; position: relative; overflow: hidden;
}
.faq-item::before {
  content: ""; position: absolute;
  left: 0; top: 0; bottom: 0; width: 6px;
  background: #FF6200; z-index: 1;
}
/* Variação: borda lateral em accent para o acordeão de destaque */
.faq-item.faq-highlight::before { background: #FF6200; }

.faq-question {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20px 24px 20px 24px; margin-left: 6px;
  font-size: 1rem; font-weight: 700; cursor: pointer; list-style: none;
}
.faq-question:hover { background: var(--accent); color: #FFF; }
.faq-question:hover .faq-icon { color: #FFF; }
.faq-question::-webkit-details-marker { display: none; }
.faq-icon { font-size: 1.5rem; line-height: 1; transition: transform 0.2s; }
.faq-item[open] .faq-icon { transform: rotate(45deg); }
.faq-answer { padding: 0 24px 24px 30px; font-weight: 500; font-size: 0.95rem; line-height: 1.6; }

/* Steps do "Como testar" */
.how-to-method { margin-top: 16px; }
.how-to-method:first-child { margin-top: 0; }
.how-to-method h3 {
  font-size: 0.85rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.5px; color: var(--accent); margin-bottom: 10px;
  display: flex; align-items: center; gap: 8px;
}
.how-to-method h3 svg { width: 16px; height: 16px; fill: var(--accent); flex-shrink: 0; }
.how-to-steps { display: flex; flex-direction: column; gap: 8px; }
.how-to-step {
  display: flex; gap: 12px; align-items: flex-start;
}
.step-num {
  width: 24px; height: 24px; border-radius: 50%;
  background: var(--accent); color: #FFF;
  font-size: 0.75rem; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-top: 1px;
}
.step-text { font-size: 0.9rem; font-weight: 500; line-height: 1.5; }
.step-text strong { font-weight: 700; }
.how-to-divider {
  border: none; border-top: 1px solid var(--border);
  margin: 16px 0;
}

/* ── RESPONSIVO / MOTION ── */
@media (max-width: 600px) {
  .preview-area h2 { font-size: 2rem; }
  .actions { flex-direction: column; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
}
</style>
</head>
<body>

<a href="#main-content" class="sr-only" style="position:absolute;top:8px;left:8px;z-index:9999;background:var(--bg-card);color:var(--text);padding:8px 16px;border:2px solid var(--border);border-radius:4px;text-decoration:none;font-weight:700;">
  Pular para o conteúdo principal
</a>

<main class="container" id="main-content">
  <h1 class="sr-only">Validador de Contraste de Cores - WCAG</h1>

  <div class="header-bar">
    <label for="themeSelect" class="sr-only">Tema da interface</label>
    <select id="themeSelect" class="theme-select">
      <option value="light">Tema Claro</option>
      <option value="dark">Tema Escuro</option>
    </select>
  </div>

  <div class="preview-area" id="preview" aria-hidden="true"
       style="color:#000000;background-color:#FFFFFF;">
    <h2>O Design Importa</h2>
    <p>Testando a acessibilidade das cores na web.</p>
  </div>

  <fieldset class="controls" style="border:none;padding:0;margin:0;">
    <legend class="sr-only">Cores para cálculo de contraste</legend>

    <!-- COR DO TEXTO -->
    <div class="input-card">
      <span id="label-text" class="input-label">Cor do Texto</span>
      <div class="input-row">
        <button type="button" class="color-swatch-btn" id="textSwatchBtn"
          aria-label="Abrir seletor de cor do texto. Cor atual: preto, #000000"
          aria-expanded="false" aria-haspopup="dialog"
          aria-controls="textPickerPopover" style="background:#000000;"></button>

        <div class="picker-popover" id="textPickerPopover"
             role="dialog" aria-labelledby="textPickerTitle" aria-modal="true">
          <span id="textPickerTitle" class="sr-only">Seletor de cor do texto</span>
          <div class="picker-canvas-wrap" id="textCanvasWrap" aria-hidden="true">
            <canvas class="picker-canvas" id="textCanvas" width="220" height="140"></canvas>
            <div class="picker-cursor" id="textCursor"></div>
          </div>
          <div class="picker-hue-wrap" id="textHueWrap" aria-hidden="true">
            <div class="picker-hue-thumb" id="textHueThumb"></div>
          </div>
          <div class="picker-hex-row">
            <label for="textPickerHex" class="picker-hex-label">HEX</label>
            <input type="text" class="picker-hex-input" id="textPickerHex"
              value="#000000" maxlength="7" autocomplete="off" spellcheck="false"
              aria-label="Valor hexadecimal da cor do texto">
          </div>
          <div class="picker-actions">
            <button type="button" class="picker-eyedropper-btn" id="textEyedropperBtn"
              aria-label="Usar conta-gotas para capturar cor do texto da tela">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M20.71 5.63l-2.34-2.34a1 1 0 0 0-1.41 0l-3.12 3.12-1.41-1.42-1.42 1.42 1.41 1.41-6.6 6.6A2 2 0 0 0 5 16v3h3a2 2 0 0 0 1.42-.59l6.6-6.6 1.41 1.42 1.42-1.42-1.42-1.41 3.12-3.12a1 1 0 0 0 0-1.65zM8 17H7v-1l6.6-6.58 1 1z"/>
              </svg>
              Conta-gotas
            </button>
            <button type="button" class="picker-close-btn" id="textPickerClose">Confirmar</button>
          </div>
        </div><!-- fim textPickerPopover -->

        <label for="textColorHex" class="sr-only">Hexadecimal da cor do texto</label>
        <input type="text" class="hex-main-input" id="textColorHex"
          value="#000000" maxlength="7" autocomplete="off" spellcheck="false"
          aria-labelledby="label-text">
      </div>
    </div>

    <!-- COR DO FUNDO -->
    <div class="input-card">
      <span id="label-bg" class="input-label">Cor do Fundo</span>
      <div class="input-row">
        <button type="button" class="color-swatch-btn" id="bgSwatchBtn"
          aria-label="Abrir seletor de cor do fundo. Cor atual: branco, #FFFFFF"
          aria-expanded="false" aria-haspopup="dialog"
          aria-controls="bgPickerPopover" style="background:#FFFFFF;"></button>

        <div class="picker-popover" id="bgPickerPopover"
             role="dialog" aria-labelledby="bgPickerTitle" aria-modal="true">
          <span id="bgPickerTitle" class="sr-only">Seletor de cor do fundo</span>
          <div class="picker-canvas-wrap" id="bgCanvasWrap" aria-hidden="true">
            <canvas class="picker-canvas" id="bgCanvas" width="220" height="140"></canvas>
            <div class="picker-cursor" id="bgCursor"></div>
          </div>
          <div class="picker-hue-wrap" id="bgHueWrap" aria-hidden="true">
            <div class="picker-hue-thumb" id="bgHueThumb"></div>
          </div>
          <div class="picker-hex-row">
            <label for="bgPickerHex" class="picker-hex-label">HEX</label>
            <input type="text" class="picker-hex-input" id="bgPickerHex"
              value="#FFFFFF" maxlength="7" autocomplete="off" spellcheck="false"
              aria-label="Valor hexadecimal da cor do fundo">
          </div>
          <div class="picker-actions">
            <button type="button" class="picker-eyedropper-btn" id="bgEyedropperBtn"
              aria-label="Usar conta-gotas para capturar cor do fundo da tela">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M20.71 5.63l-2.34-2.34a1 1 0 0 0-1.41 0l-3.12 3.12-1.41-1.42-1.42 1.42 1.41 1.41-6.6 6.6A2 2 0 0 0 5 16v3h3a2 2 0 0 0 1.42-.59l6.6-6.6 1.41 1.42 1.42-1.42-1.42-1.41 3.12-3.12a1 1 0 0 0 0-1.65zM8 17H7v-1l6.6-6.58 1 1z"/>
              </svg>
              Conta-gotas
            </button>
            <button type="button" class="picker-close-btn" id="bgPickerClose">Confirmar</button>
          </div>
        </div><!-- fim bgPickerPopover -->

        <label for="bgColorHex" class="sr-only">Hexadecimal da cor do fundo</label>
        <input type="text" class="hex-main-input" id="bgColorHex"
          value="#FFFFFF" maxlength="7" autocomplete="off" spellcheck="false"
          aria-labelledby="label-bg">
      </div>
    </div>

  </fieldset>

  <div class="ratio-header">
    <p id="ratio-label" class="ratio-label">Razão de Contraste</p>
    <div class="ratio-value" id="ratioValue" aria-labelledby="ratio-label">--</div>
  </div>

  <div id="a11y-announcer" class="sr-only" aria-live="polite" aria-atomic="true" role="status"></div>

  <div class="results-grid">
    <div class="result-card" id="card-aa-normal" role="region" aria-label="Resultado AA Normal">
      <div class="card-header">
        <span>AA — Normal</span>
        <span class="wcag-version">WCAG 1.4.3</span>
      </div>
      <div class="status" id="status-aa-normal">
        <span aria-hidden="true" id="icon-aa-normal">✓</span>
        <span id="text-aa-normal">Passa</span>
      </div>
      <div class="req-text">Mín. 4.5:1 — texto regular &lt; 18pt</div>
    </div>
    <div class="result-card" id="card-aa-large" role="region" aria-label="Resultado AA Grande">
      <div class="card-header">
        <span>AA — Grande</span>
        <span class="wcag-version">WCAG 1.4.3</span>
      </div>
      <div class="status" id="status-aa-large">
        <span aria-hidden="true" id="icon-aa-large">✓</span>
        <span id="text-aa-large">Passa</span>
      </div>
      <div class="req-text">Mín. 3:1 — texto ≥ 18pt ou ≥ 14pt bold</div>
    </div>
  </div>

  <div class="actions">
    <button id="btn-copy" class="btn" type="button">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
      </svg>
      <span id="btn-copy-label">Copiar resultado</span>
    </button>
    <button id="btn-export-pdf" class="btn" type="button">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
      </svg>
      Exportar para PDF
    </button>
  </div>

  <section class="faq-section" aria-labelledby="faq-heading">
    <h2 id="faq-heading">Perguntas frequentes</h2>

    <!-- NOVO: primeiro acordeão — Como testar -->
    <details class="faq-item faq-highlight">
      <summary class="faq-question">
        <span>Como testar o contraste de cores?</span>
        <span class="faq-icon" aria-hidden="true">+</span>
      </summary>
      <div class="faq-answer">
        <p style="margin-bottom:16px;">Há dois métodos para realizar o teste: usando o <strong>conta-gotas</strong> para capturar cores diretamente da tela, ou inserindo os <strong>códigos HEX</strong> manualmente. Ambos atualizam o resultado em tempo real.</p>

        <!-- MÉTODO 1: Conta-gotas -->
        <div class="how-to-method">
          <h3>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.71 5.63l-2.34-2.34a1 1 0 0 0-1.41 0l-3.12 3.12-1.41-1.42-1.42 1.42 1.41 1.41-6.6 6.6A2 2 0 0 0 5 16v3h3a2 2 0 0 0 1.42-.59l6.6-6.6 1.41 1.42 1.42-1.42-1.42-1.41 3.12-3.12a1 1 0 0 0 0-1.65zM8 17H7v-1l6.6-6.58 1 1z"/>
            </svg>
            Método 1 — Conta-gotas (captura visual)
          </h3>
          <div class="how-to-steps">
            <div class="how-to-step">
              <span class="step-num" aria-hidden="true">1</span>
              <p class="step-text">Clique no <strong>quadrado colorido</strong> ao lado do campo "Cor do Texto" para abrir o seletor.</p>
            </div>
            <div class="how-to-step">
              <span class="step-num" aria-hidden="true">2</span>
              <p class="step-text">Clique no botão <strong>"Conta-gotas"</strong> dentro do seletor. O popover fecha e o cursor muda para o ícone de conta-gotas.</p>
            </div>
            <div class="how-to-step">
              <span class="step-num" aria-hidden="true">3</span>
              <p class="step-text"><strong>Clique sobre o texto</strong> que deseja avaliar em qualquer ponto da tela. A cor é capturada automaticamente e o campo HEX é preenchido.</p>
            </div>
            <div class="how-to-step">
              <span class="step-num" aria-hidden="true">4</span>
              <p class="step-text">Repita o processo para a <strong>"Cor do Fundo"</strong>, capturando a cor de fundo do elemento avaliado.</p>
            </div>
            <div class="how-to-step">
              <span class="step-num" aria-hidden="true">5</span>
              <p class="step-text">A <strong>razão de contraste</strong> e os resultados WCAG 1.4.3 são exibidos automaticamente. Verifique se o critério exigido (AA Normal ou AA Grande) indica <em>Passa</em>.</p>
            </div>
          </div>
        </div>

        <hr class="how-to-divider" aria-hidden="true">

        <!-- MÉTODO 2: Código HEX -->
        <div class="how-to-method">
          <h3>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/>
            </svg>
            Método 2 — Código HEX (inserção manual)
          </h3>
          <div class="how-to-steps">
            <div class="how-to-step">
              <span class="step-num" aria-hidden="true">1</span>
              <p class="step-text">Obtenha os códigos HEX das cores no <strong>Figma</strong>, no <strong>código-fonte</strong> (CSS/tokens) ou na ferramenta de inspeção do navegador (DevTools).</p>
            </div>
            <div class="how-to-step">
              <span class="step-num" aria-hidden="true">2</span>
              <p class="step-text">Digite ou cole o código no campo <strong>"Cor do Texto"</strong> no formato <code style="font-family:monospace;font-weight:700;">#RRGGBB</code>, por exemplo <code style="font-family:monospace;font-weight:700;">#1F2937</code>.</p>
            </div>
            <div class="how-to-step">
              <span class="step-num" aria-hidden="true">3</span>
              <p class="step-text">Repita para o campo <strong>"Cor do Fundo"</strong> com a cor de fundo do componente avaliado.</p>
            </div>
            <div class="how-to-step">
              <span class="step-num" aria-hidden="true">4</span>
              <p class="step-text">A <strong>razão de contraste</strong> é calculada ao completar os 7 caracteres do HEX. Confirme se o resultado atende ao critério <strong>WCAG 1.4.3</strong>: mínimo de <strong>4,5:1</strong> para texto regular ou <strong>3:1</strong> para texto grande.</p>
            </div>
          </div>
        </div>
      </div>
    </details>

    <details class="faq-item">
      <summary class="faq-question">
        <span>Qual é a finalidade de um verificador de contraste?</span>
        <span class="faq-icon" aria-hidden="true">+</span>
      </summary>
      <div class="faq-answer">
        Um verificador de contraste existe para garantir que o texto seja legível para todos os usuários, em especial para pessoas com baixa visão ou daltonismo. Ele calcula a diferença de luminosidade entre a cor do texto e do fundo.
      </div>
    </details>
    <details class="faq-item">
      <summary class="faq-question">
        <span>O que são as WCAG e por que elas são importantes para o contraste?</span>
        <span class="faq-icon" aria-hidden="true">+</span>
      </summary>
      <div class="faq-answer">
        As WCAG (Web Content Accessibility Guidelines) são diretrizes internacionais que definem como tornar o conteúdo web mais acessível. Elas estabelecem regras matemáticas de contraste mínimo.
      </div>
    </details>
    <details class="faq-item">
      <summary class="faq-question">
        <span>Qual é a taxa de contraste ideal?</span>
        <span class="faq-icon" aria-hidden="true">+</span>
      </summary>
      <div class="faq-answer">
        Segundo as WCAG nível AA, a taxa mínima é de <strong>4.5:1</strong> para textos regulares e <strong>3.0:1</strong> para textos grandes (≥ 18pt ou ≥ 14pt negrito).
      </div>
    </details>
  </section>
</main>

<script>
// ── TEMA ─────────────────────────────────────────────────────────────────────
const themeSelect = document.getElementById('themeSelect');
const root = document.documentElement;
const saved = localStorage.getItem('wcag-theme') || 'light';
themeSelect.value = saved;
root.setAttribute('data-theme', saved);
themeSelect.addEventListener('change', e => {
  root.setAttribute('data-theme', e.target.value);
  localStorage.setItem('wcag-theme', e.target.value);
});

// ── UTILITÁRIOS DE COR ────────────────────────────────────────────────────────
function hexToRgb(hex) {
  const n = parseInt(hex.replace('#',''), 16);
  return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
}
function rgbToHex(r, g, b) {
  return '#' + [r,g,b].map(v =>
    Math.round(Math.max(0, Math.min(255, v))).toString(16).padStart(2,'0')
  ).join('').toUpperCase();
}
function hsvToRgb(h, s, v) {
  h %= 360; s /= 100; v /= 100;
  const c = v*s, x = c*(1-Math.abs((h/60)%2-1)), m = v-c;
  let r=0, g=0, b=0;
  if      (h<60)  { r=c; g=x; }
  else if (h<120) { r=x; g=c; }
  else if (h<180) { g=c; b=x; }
  else if (h<240) { g=x; b=c; }
  else if (h<300) { r=x; b=c; }
  else            { r=c; b=x; }
  return { r:Math.round((r+m)*255), g:Math.round((g+m)*255), b:Math.round((b+m)*255) };
}
function rgbToHsv(r, g, b) {
  r/=255; g/=255; b/=255;
  const max=Math.max(r,g,b), d=max-Math.min(r,g,b);
  let h=0, s=max===0?0:d/max, vv=max;
  if (d) {
    if      (max===r) h=((g-b)/d)%6;
    else if (max===g) h=(b-r)/d+2;
    else              h=(r-g)/d+4;
    h=Math.round(h*60); if(h<0) h+=360;
  }
  return { h, s:s*100, v:vv*100 };
}
function getLuminance(r,g,b) {
  return [r,g,b].map(v => {
    v/=255; return v<=0.03928 ? v/12.92 : Math.pow((v+0.055)/1.055, 2.4);
  }).reduce((a,v,i) => a+v*[0.2126,0.7152,0.0722][i], 0);
}
function calcContrast(h1, h2) {
  const {r:r1,g:g1,b:b1}=hexToRgb(h1), {r:r2,g:g2,b:b2}=hexToRgb(h2);
  const l1=getLuminance(r1,g1,b1), l2=getLuminance(r2,g2,b2);
  return (Math.max(l1,l2)+0.05)/(Math.min(l1,l2)+0.05);
}
function colorName(hex) {
  const {r,g,b}=hexToRgb(hex), {h,s,v}=rgbToHsv(r,g,b);
  if (v<10) return 'preto';
  if (v>90&&s<10) return 'branco';
  if (s<15) return `cinza (${hex})`;
  const names=['vermelho','laranja','amarelo','verde-amarelo','verde','ciano','azul','roxo','magenta','rosa'];
  return `${names[Math.round(h/36)%10]} (${hex})`;
}

// ── LIVE REGION (declarada antes da factory para uso no eyedropper) ───────────
const announcer = document.getElementById('a11y-announcer');

// ── FACTORY DO PICKER ─────────────────────────────────────────────────────────
function createPicker(prefix, onChange) {
  const swatchBtn     = document.getElementById(`${prefix}SwatchBtn`);
  const popover       = document.getElementById(`${prefix}PickerPopover`);
  const canvasEl      = document.getElementById(`${prefix}Canvas`);
  const cursor        = document.getElementById(`${prefix}Cursor`);
  const hueWrap       = document.getElementById(`${prefix}HueWrap`);
  const hueThumb      = document.getElementById(`${prefix}HueThumb`);
  const hexInput      = document.getElementById(`${prefix}PickerHex`);
  const closeBtn      = document.getElementById(`${prefix}PickerClose`);
  const eyedropperBtn = document.getElementById(`${prefix}EyedropperBtn`);
  const ctx           = canvasEl.getContext('2d');
  let H=0, S=0, V=100;

  // Oculta o botão se o navegador não suportar a EyeDropper API (Firefox, Safari)
  if (!window.EyeDropper) eyedropperBtn.classList.add('unsupported');

  function draw() {
    const W=canvasEl.width, HH=canvasEl.height;
    const {r,g,b}=hsvToRgb(H,100,100);
    const gH=ctx.createLinearGradient(0,0,W,0);
    gH.addColorStop(0,'#FFF'); gH.addColorStop(1,`rgb(${r},${g},${b})`);
    ctx.fillStyle=gH; ctx.fillRect(0,0,W,HH);
    const gV=ctx.createLinearGradient(0,0,0,HH);
    gV.addColorStop(0,'rgba(0,0,0,0)'); gV.addColorStop(1,'rgba(0,0,0,1)');
    ctx.fillStyle=gV; ctx.fillRect(0,0,W,HH);
  }
  function syncCursor() {
    cursor.style.left = (S/100)*canvasEl.offsetWidth  + 'px';
    cursor.style.top  = (1-V/100)*canvasEl.offsetHeight + 'px';
  }
  function syncHue() { hueThumb.style.left = (H/360)*100+'%'; }

  function apply(h, s, v) {
    H=h; S=s; V=v; draw(); syncCursor(); syncHue();
    const rgb=hsvToRgb(H,S,V), hex=rgbToHex(rgb.r,rgb.g,rgb.b);
    hexInput.value=hex; swatchBtn.style.background=hex; onChange(hex);
  }

  function setValue(hex) {
    if (!/^#[0-9A-F]{6}$/i.test(hex)) return;
    const {r,g,b}=hexToRgb(hex), hsv=rgbToHsv(r,g,b);
    apply(hsv.h, hsv.s, hsv.v); hexInput.value=hex.toUpperCase();
    const who=prefix==='text'?'texto':'fundo';
    swatchBtn.setAttribute('aria-label',`Abrir seletor de cor do ${who}. Cor atual: ${colorName(hex)}`);
  }

  function open() {
    popover.classList.add('open'); swatchBtn.setAttribute('aria-expanded','true');
    draw(); syncCursor(); syncHue();
    setTimeout(()=>hexInput.focus(), 50);
  }
  function close() {
    popover.classList.remove('open'); swatchBtn.setAttribute('aria-expanded','false');
    swatchBtn.focus();
  }

  swatchBtn.addEventListener('click', () => {
    document.querySelectorAll('.picker-popover.open').forEach(p => {
      if (p!==popover) { p.classList.remove('open'); document.querySelector(`[aria-controls="${p.id}"]`)?.setAttribute('aria-expanded','false'); }
    });
    popover.classList.contains('open') ? close() : open();
  });
  closeBtn.addEventListener('click', close);

  // EyeDropper API — captura cor de qualquer ponto da tela
  // Suportado no Chrome/Edge 95+; botão já está oculto em navegadores sem suporte
  eyedropperBtn.addEventListener('click', async () => {
    try {
      // O popover precisa fechar para não obstruir a tela durante a captura
      popover.classList.remove('open');
      swatchBtn.setAttribute('aria-expanded', 'false');
      const result = await new EyeDropper().open();
      // result.sRGBHex vem no formato #rrggbb
      const hex = result.sRGBHex.toUpperCase();
      setValue(hex);
      // Reabre o popover com a cor capturada para o usuário confirmar
      open();
      announcer.textContent = '';
      requestAnimationFrame(() => {
        announcer.textContent = `Cor capturada pelo conta-gotas: ${hex}`;
      });
    } catch {
      // Usuário cancelou (pressou Escape) — apenas reabre o popover
      open();
    }
  });

  popover.addEventListener('keydown', e => { if (e.key==='Escape') { e.preventDefault(); close(); } });
  document.addEventListener('click', e => {
    if (popover.classList.contains('open') && !popover.contains(e.target) && e.target!==swatchBtn) close();
  });

  function fromCanvas(e) {
    const r=canvasEl.getBoundingClientRect();
    apply(H, Math.max(0,Math.min((e.clientX-r.left)/r.width,1))*100,
             (1-Math.max(0,Math.min((e.clientY-r.top)/r.height,1)))*100);
  }
  let dc=false;
  canvasEl.parentElement.addEventListener('mousedown', e=>{dc=true;fromCanvas(e);});
  document.addEventListener('mousemove',  e=>{if(dc)fromCanvas(e);});
  document.addEventListener('mouseup',    ()=>{dc=false;});
  canvasEl.parentElement.addEventListener('touchstart', e=>{e.preventDefault();dc=true;fromCanvas(e.touches[0]);},{passive:false});
  document.addEventListener('touchmove',  e=>{if(dc){e.preventDefault();fromCanvas(e.touches[0]);}},{passive:false});
  document.addEventListener('touchend',   ()=>{dc=false;});

  function fromHue(e) {
    const r=hueWrap.getBoundingClientRect();
    apply(Math.max(0,Math.min((e.clientX-r.left)/r.width,1))*360, S, V);
  }
  let dh=false;
  hueWrap.addEventListener('mousedown', e=>{dh=true;fromHue(e);});
  document.addEventListener('mousemove',  e=>{if(dh)fromHue(e);});
  document.addEventListener('mouseup',    ()=>{dh=false;});
  hueWrap.addEventListener('touchstart', e=>{e.preventDefault();dh=true;fromHue(e.touches[0]);},{passive:false});
  document.addEventListener('touchmove',  e=>{if(dh){e.preventDefault();fromHue(e.touches[0]);}},{passive:false});
  document.addEventListener('touchend',   ()=>{dh=false;});

  hexInput.addEventListener('input', e => {
    let v=e.target.value.trim();
    if (!v.startsWith('#')) v='#'+v;
    if (v.length<=7) hexInput.value=v.toUpperCase();
    if (/^#[0-9A-F]{6}$/i.test(v)) { const {r,g,b}=hexToRgb(v),hsv=rgbToHsv(r,g,b); apply(hsv.h,hsv.s,hsv.v); }
  });

  draw();
  return { setValue };
}

// ── REFS PRINCIPAIS ───────────────────────────────────────────────────────────
const textHexEl   = document.getElementById('textColorHex');
const bgHexEl     = document.getElementById('bgColorHex');
const preview     = document.getElementById('preview');
const ratioEl     = document.getElementById('ratioValue');
let results = [];

function updateCard(id, passed) {
  const card=document.getElementById(`card-${id}`);
  const lbl=id==='aa-normal'?'AA Normal':'AA Grande';
  card.classList.toggle('pass', passed); card.classList.toggle('fail', !passed);
  document.getElementById(`status-${id}`).className=`status ${passed?'pass':'fail'}`;
  document.getElementById(`icon-${id}`).textContent=passed?'✓':'✕';
  document.getElementById(`text-${id}`).textContent=passed?'Passa':'Falha';
  card.setAttribute('aria-label',`Resultado ${lbl}: ${passed?'Passa':'Falha'}`);
  return passed?'Passa':'Falha';
}

function updateUI() {
  const t=textHexEl.value, b=bgHexEl.value;
  if (!/^#[0-9A-F]{6}$/i.test(t)||!/^#[0-9A-F]{6}$/i.test(b)) return;
  preview.style.color=t; preview.style.backgroundColor=b;
  const ratio=calcContrast(t,b), fmt=ratio.toFixed(2);
  ratioEl.textContent=fmt+':1';
  const rN=updateCard('aa-normal',ratio>=4.5), rG=updateCard('aa-large',ratio>=3.0);
  results=[
    {nivel:'AA — Normal',criterio:'WCAG 1.4.3',status:rN,requisito:'Mín. 4.5:1 — texto regular < 18pt'},
    {nivel:'AA — Grande',criterio:'WCAG 1.4.3',status:rG,requisito:'Mín. 3:1 — texto ≥ 18pt ou ≥ 14pt bold'},
  ];
  announcer.textContent='';
  requestAnimationFrame(()=>{ announcer.textContent=`Razão de contraste: ${fmt} para 1. Cor do texto: ${t}. Cor do fundo: ${b}. AA Normal: ${rN}. AA Grande: ${rG}.`; });
}

// ── PICKERS ───────────────────────────────────────────────────────────────────
const textPicker = createPicker('text', hex=>{ textHexEl.value=hex; updateUI(); });
const bgPicker   = createPicker('bg',   hex=>{ bgHexEl.value=hex;   updateUI(); });

textHexEl.addEventListener('input', e=>{
  let v=e.target.value; if(!v.startsWith('#'))v='#'+v;
  if(v.length<=7)textHexEl.value=v.toUpperCase();
  if(/^#[0-9A-F]{6}$/i.test(v)){textPicker.setValue(v);updateUI();}
});
bgHexEl.addEventListener('input', e=>{
  let v=e.target.value; if(!v.startsWith('#'))v='#'+v;
  if(v.length<=7)bgHexEl.value=v.toUpperCase();
  if(/^#[0-9A-F]{6}$/i.test(v)){bgPicker.setValue(v);updateUI();}
});

// ── COPIAR ────────────────────────────────────────────────────────────────────
document.getElementById('btn-copy').addEventListener('click', async () => {
  let txt=`Resultado do Teste de Contraste\nCor do Texto: ${textHexEl.value}\nCor de Fundo: ${bgHexEl.value}\nRazão: ${ratioEl.textContent}\n\n`;
  results.forEach(r=>{ txt+=`${r.nivel} (${r.criterio}): ${r.status} [${r.requisito}]\n`; });
  const lbl=document.getElementById('btn-copy-label'), orig=lbl.textContent;
  try {
    await navigator.clipboard.writeText(txt);
    lbl.textContent='Copiado com sucesso!';
    announcer.textContent=''; requestAnimationFrame(()=>{ announcer.textContent='Resultado copiado para a área de transferência.'; });
    setTimeout(()=>{ lbl.textContent=orig; }, 2500);
  } catch {
    announcer.textContent=''; requestAnimationFrame(()=>{ announcer.textContent='Erro ao copiar. Tente novamente.'; });
  }
});

// ── PDF ───────────────────────────────────────────────────────────────────────
document.getElementById('btn-export-pdf').addEventListener('click', () => {
  const {jsPDF}=window.jspdf, doc=new jsPDF();
  const t=textHexEl.value, b=bgHexEl.value, r=ratioEl.textContent;
  doc.setFont('helvetica','bold'); doc.setFontSize(18);
  doc.text('Relatório de Contraste de Cores - WCAG', 20, 20);
  doc.setFontSize(12); doc.setFont('helvetica','normal');
  doc.text(`Cor do Texto: ${t}`, 20, 35);
  doc.text(`Cor de Fundo: ${b}`, 20, 45);
  doc.setFont('helvetica','bold');
  doc.text(`Razão de Contraste: ${r}`, 20, 55);
  doc.line(20,60,190,60);
  doc.setFontSize(14); doc.text('Análise de Critérios:', 20, 75);
  let y=85; doc.setFontSize(11);
  results.forEach(res=>{
    doc.setFont('helvetica','bold'); doc.text(`${res.nivel} (${res.criterio}) — ${res.status.toUpperCase()}`, 20, y);
    doc.setFont('helvetica','normal'); doc.text(`Requisito: ${res.requisito}`, 25, y+6);
    y+=16;
  });
  doc.save(`contraste_${t}_vs_${b}.pdf`.replace(/#/g,''));
  announcer.textContent=''; requestAnimationFrame(()=>{ announcer.textContent='PDF exportado e download iniciado.'; });
});

// ── INIT ──────────────────────────────────────────────────────────────────────
textPicker.setValue('#000000');
bgPicker.setValue('#FFFFFF');
updateUI();
</script>
</body>
</html>
